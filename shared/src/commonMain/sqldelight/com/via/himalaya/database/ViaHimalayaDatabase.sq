-- Treks table
CREATE TABLE NavigatorTrek (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    guideId TEXT NOT NULL,
    startTime INTEGER NOT NULL,
    isSynced INTEGER NOT NULL DEFAULT 0
);

-- Points table
CREATE TABLE Point (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    trekId TEXT NOT NULL,
    lat REAL NOT NULL,
    lon REAL NOT NULL,
    timestamp INTEGER NOT NULL,
    altGps REAL,
    altBaro REAL,
    accuracyH REAL,
    accuracyV REAL,
    speed REAL,
    bearing REAL,
    battery INTEGER,
    rawSensorsJson TEXT,
    FOREIGN KEY (trekId) REFERENCES NavigatorTrek(id) ON DELETE CASCADE
);

-- Queries for NavigatorTrek table
insertTrek:
INSERT INTO NavigatorTrek (id, name, guideId, startTime, isSynced)
VALUES (?, ?, ?, ?, ?);

getNavigatorTrekById:
SELECT * FROM NavigatorTrek WHERE id = ?;

getUnsyncedTreks:
SELECT * FROM NavigatorTrek WHERE isSynced = 0;

getAllNavigatorTreks:
SELECT * FROM NavigatorTrek ORDER BY startTime DESC;

updateTrekSyncStatus:
UPDATE NavigatorTrek SET isSynced = ? WHERE id = ?;

-- Queries for Point table
insertPoint:
INSERT INTO Point (trekId, lat, lon, timestamp, altGps, altBaro, accuracyH, accuracyV, speed, bearing, battery, rawSensorsJson)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getPointsByTrekId:
SELECT * FROM Point WHERE trekId = ? ORDER BY timestamp ASC;

getPointsForUnsyncedTreks:
SELECT p.* FROM Point p
INNER JOIN NavigatorTrek t ON p.trekId = t.id
WHERE t.isSynced = 0
ORDER BY p.trekId, p.timestamp ASC;

deletePointsByTrekId:
DELETE FROM Point WHERE trekId = ?;

getLatestPointForTrek:
SELECT * FROM Point WHERE trekId = ? ORDER BY timestamp DESC LIMIT 1;